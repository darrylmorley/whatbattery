<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ seo.title | escape }}</title>
    <meta name="description" content="{{ seo.description | escape }}" />
    <link rel="canonical" href="{{ seo.canonical | escape }}" />
    {% if noindex %}<meta name="robots" content="noindex, follow" />{% endif %}
    <link rel="icon" href="/img/favicon.ico" sizes="any" />
    <link rel="icon" href="/img/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/img/icon.png" />

    <meta property="og:type" content="{{ seo.ogType }}" />
    <meta property="og:site_name" content="{{ site.name | escape }}" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content="{{ seo.canonical | escape }}" />
    <meta property="og:title" content="{{ seo.title | escape }}" />
    <meta property="og:description" content="{{ seo.description | escape }}" />
    <meta property="og:image" content="{{ seo.image | escape }}" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="WhatBattery — battery health, health trends and live power on your Mac" />
    {% if articleType %}<meta property="article:author" content="https://www.darrylmorley.co.uk/" />{% endif %}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ seo.title | escape }}" />
    <meta name="twitter:description" content="{{ seo.description | escape }}" />
    <meta name="twitter:image" content="{{ seo.image | escape }}" />
    <meta name="twitter:image:alt" content="WhatBattery — battery health, health trends and live power on your Mac" />
    {% if seo.schema %}<script type="application/ld+json">{{ seo.schema | safe }}</script>{% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css?v={{ styleVersion }}" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="nav" aria-label="Primary">
      <div class="wrap nav-inner">
        <a class="brand" href="/" aria-label="WhatBattery home">
          <img class="mark" src="/img/icon.png" alt="" aria-hidden="true" width="30" height="30" />
          <span>{{ site.name }}</span>
        </a>
        <div class="nav-links">
          {% include "nav-items.njk" %}
        </div>
        <details class="mobile-nav" data-mobile-nav>
          <summary aria-controls="mobile-nav-links">
            <span>Menu</span>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path class="menu-bars" d="M4 6h16M4 12h16M4 18h16" />
              <path class="menu-close" d="m6 6 12 12M18 6 6 18" />
            </svg>
          </summary>
          <div class="mobile-nav-links" id="mobile-nav-links">
            {% include "nav-items.njk" %}
          </div>
        </details>
      </div>
    </nav>

    <main id="main">
{{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <a class="brand footer-logo" href="/">
            <img class="mark" src="/img/icon.png" alt="" aria-hidden="true" width="30" height="30" />
            <span>WhatBattery</span>
          </a>
          <p>Understand your battery’s condition, charging and power use.</p>
          <p class="footer-small">A <a href="https://www.bitmoor.co.uk">Bitmoor</a> product by <a href="https://github.com/darrylmorley">Darryl</a>.</p>
        </div>
        <div>
          <h2>Product</h2>
          <a href="/features/">Features</a>
          <a href="/pro/">WhatBattery Pro</a>
          <a href="/cli/">CLI</a>
          <a href="{{ site.download }}">Download</a>
        </div>
        <div>
          <h2>Resources</h2>
          <a href="/docs/">Guides</a>
          <a href="/faq/">FAQ</a>
          <a href="/blog/">Blog</a>
          <a href="/press/">Press</a>
          <a href="{{ site.repo }}">Source on GitHub</a>
        </div>
        <div>
          <h2>Family</h2>
          <a href="https://www.whatcable.uk">WhatCable</a>
          <a href="https://www.whatport.app">WhatPort</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>MIT licensed. Read-only: it never changes how your devices charge.</span>
        <span>Apple Silicon · macOS 14+</span>
      </div>
    </footer>

    <script>
      // Native details keeps navigation usable before JavaScript loads, or without it.
      (function () {
        var menu = document.querySelector("[data-mobile-nav]");
        var trigger = menu.querySelector("summary");
        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape" && menu.open) {
            menu.open = false;
            trigger.focus();
          }
        });
        document.addEventListener("click", function (event) {
          if (!menu.contains(event.target) || event.target.closest("a")) menu.open = false;
        });
        document.addEventListener("focusin", function (event) {
          if (menu.open && !menu.contains(event.target)) menu.open = false;
        });
        window.matchMedia("(min-width: 981px)").addEventListener("change", function (event) {
          if (event.matches) menu.open = false;
        });
      })();
    </script>

    <script>
      (function () {
        var buttons = document.querySelectorAll("[data-buy-pro]");
        var errorSlots = document.querySelectorAll("[data-buy-error]");
        buttons.forEach(function (button) {
          var originalHTML = button.innerHTML;
          button.addEventListener("click", async function () {
            buttons.forEach(function (candidate) { candidate.disabled = true; });
            button.textContent = "Starting secure checkout…";
            errorSlots.forEach(function (slot) { slot.hidden = true; slot.textContent = ""; });
            try {
              var res = await fetch("{{ site.worker }}/api/checkout", { method: "POST" });
              var data = await res.json();
              if (res.ok && data.url) {
                window.location.href = data.url;
              } else {
                throw new Error(data.error || "Could not start checkout. Please try again.");
              }
            } catch (err) {
              errorSlots.forEach(function (slot) { slot.textContent = err.message || "Could not start checkout. Please try again."; slot.hidden = false; });
              buttons.forEach(function (candidate) { candidate.disabled = false; });
              button.innerHTML = originalHTML;
            }
          });
        });
      })();
    </script>
  </body>
</html>
