<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }}: know your battery's real health and where it's heading{% endif %}</title>
    <meta name="description" content="{{ description or site.tagline }}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <link rel="icon" href="/img/favicon.ico" sizes="any" />
    <link rel="icon" href="/img/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/img/icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:title" content="{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }}: know your battery's real health and where it's heading{% endif %}" />
    <meta property="og:description" content="{{ description or site.tagline }}" />
    <meta property="og:image" content="{{ site.url }}/img/og-whatbattery.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }}{% endif %}" />
    <meta name="twitter:description" content="{{ description or site.tagline }}" />
    <meta name="twitter:image" content="{{ site.url }}/img/og-whatbattery.png" />

{% if page.url == '/' or page.url == '/pro/' %}
    {# One entity, emitted on the two pages that sell the app. The shared @id
       tells a parser these are the same thing described twice, not two apps.
       softwareVersion comes from site.json, which scripts/release.sh patches
       in the same commit as the app's own version: a literal here would be
       stale from the first release after it was written. Note the site builds
       on the public mirror, where scripts/ does not exist, so the version has
       to travel in mirrored data rather than be read from the release script. #}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "@id": "{{ site.url }}/#app",
      "name": "WhatBattery",
      "softwareVersion": "{{ site.version }}",
      "operatingSystem": "macOS 14 or later, Apple Silicon",
      "applicationCategory": "UtilitiesApplication",
      "applicationSubCategory": "Battery health and power monitoring",
      "url": "{{ site.url }}/",
      "downloadUrl": "{{ site.download }}",
      "installUrl": "{{ site.url }}/#install",
      "releaseNotes": "{{ site.releases }}",
      "description": "{{ site.tagline | safe }}",
      "image": "{{ site.url }}/img/og-whatbattery.png",
      "screenshot": [
        "{{ site.url }}/img/screenshot-mac.png",
        "{{ site.url }}/img/screenshot-sleep.png",
        "{{ site.url }}/img/screenshot-apps.png",
        "{{ site.url }}/img/screenshot-charging.png",
        "{{ site.url }}/img/screenshot-history.png"
      ],
      "featureList": [
        "True battery health from the fuel gauge, with the service condition macOS reports",
        "Live charge and discharge power in watts, with the connected adapter",
        "Battery runway: wear rate and a projected replacement window",
        "Sleep and wake diagnosis: overnight drain, wake reasons, and what is holding the Mac awake",
        "Per-app power use in real watts, live and historical",
        "Charging sessions with a verdict on each charger",
        "Per-cell voltage, capacity and resistance from the pack",
        "Long-term health history for Macs, iPhones and iPads",
        "Bluetooth accessory battery levels with time-to-empty estimates",
        "PDF report and CSV or JSON export"
      ],
      "author": { "@type": "Person", "name": "Darryl Morley" },
      "offers": [
        { "@type": "Offer", "name": "WhatBattery", "price": "0", "priceCurrency": "GBP" },
        { "@type": "Offer", "name": "WhatBattery Pro", "price": "9.99", "priceCurrency": "GBP", "url": "{{ site.url }}/pro/" }
      ]
    }
    </script>
{% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css?v={{ styleVersion }}" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="nav" aria-label="Primary">
      <div class="wrap nav-inner">
        <a class="brand" href="/" aria-label="WhatBattery home">
          <img class="mark" src="/img/icon.png" alt="" aria-hidden="true" width="30" height="30" />
          <span>{{ site.name }}</span>
        </a>
        <div class="nav-links">
          <a href="/features/">Features</a>
          <a href="/pro/">Pro</a>
          <a href="/docs/">Guides</a>
          <a href="/cli/">CLI</a>
          <a href="/blog/">Blog</a>
          <a href="{{ site.repo }}">GitHub</a>
          <a class="button nav-cta" href="{{ site.download }}">Download free</a>
        </div>
      </div>
    </nav>

    <main id="main">
{{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <a class="brand footer-logo" href="/">
            <img class="mark" src="/img/icon.png" alt="" aria-hidden="true" width="30" height="30" />
            <span>WhatBattery</span>
          </a>
          <p>Know your battery's real health, live power use, and where it is heading.</p>
          <p class="footer-small">A <a href="https://www.bitmoor.co.uk">Bitmoor</a> product by <a href="https://github.com/darrylmorley">Darryl Morley</a>.</p>
        </div>
        <div>
          <h2>Product</h2>
          <a href="/features/">Features</a>
          <a href="/pro/">WhatBattery Pro</a>
          <a href="/cli/">CLI</a>
          <a href="{{ site.download }}">Download</a>
        </div>
        <div>
          <h2>Resources</h2>
          <a href="/docs/">Guides</a>
          <a href="/faq/">FAQ</a>
          <a href="/blog/">Blog</a>
          <a href="/press/">Press</a>
          <a href="{{ site.repo }}">Source on GitHub</a>
        </div>
        <div>
          <h2>Family</h2>
          <a href="https://www.whatcable.uk">WhatCable</a>
          <a href="https://www.whatport.app">WhatPort</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>MIT licensed. Read-only: it never changes how your devices charge.</span>
        <span>Apple Silicon · macOS 14+</span>
      </div>
    </footer>

    <script>
      (function () {
        var buttons = document.querySelectorAll("[data-buy-pro]");
        var errorSlots = document.querySelectorAll("[data-buy-error]");
        buttons.forEach(function (button) {
          var originalHTML = button.innerHTML;
          button.addEventListener("click", async function () {
            buttons.forEach(function (candidate) { candidate.disabled = true; });
            button.textContent = "Starting secure checkout…";
            errorSlots.forEach(function (slot) { slot.hidden = true; slot.textContent = ""; });
            try {
              var res = await fetch("{{ site.worker }}/api/checkout", { method: "POST" });
              var data = await res.json();
              if (res.ok && data.url) {
                window.location.href = data.url;
              } else {
                throw new Error(data.error || "Could not start checkout. Please try again.");
              }
            } catch (err) {
              errorSlots.forEach(function (slot) { slot.textContent = err.message || "Could not start checkout. Please try again."; slot.hidden = false; });
              buttons.forEach(function (candidate) { candidate.disabled = false; });
              button.innerHTML = originalHTML;
            }
          });
        });
      })();
    </script>
  </body>
</html>
